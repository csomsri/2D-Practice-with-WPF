<Window x:Class="_2D_Practice_with_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2D_Practice_with_WPF"
        ClipToBounds="True"
        mc:Ignorable="d" Height="168" Width="120"
       >

    <!-- Display Infomration-->
    <Canvas>
        <Canvas.Resources>
            <ControlTemplate x:Key="ClockHanTamplate" TargetType="Control">
                <Polygon Points="-0.3,-1  -0.2,8  0,9  0.2,8 0.3, -1"
                         Fill="Navy"/>
            </ControlTemplate>
        </Canvas.Resources>

        <Ellipse Canvas.Left="-10.0" Canvas.Top="-10.0"
                 Width="20" Height="20"
                 
                 Fill="LightGray"/>
        <Ellipse Canvas.Left="-.5" Canvas.Top="-9.0"
                 Width="1" Height="1"
                 Fill="Blue"/>

        <Control Name="MinuteHand"
                 Template="{StaticResource ClockHanTamplate}"/>

        <Control Name="HourHand" Template="{StaticResource ClockHanTamplate}">
            <Control.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1.7" ScaleY="0.7" CenterX="0" CenterY="0"/>
                    <RotateTransform Angle="180" CenterX="0" CenterY="0"/>
                    <RotateTransform x:Name="ActualTimeHour" Angle="0"/>
                </TransformGroup>
                
            </Control.RenderTransform>
        </Control>
        
        
        <Canvas.RenderTransform>
            <TransformGroup>
                <ScaleTransform ScaleX="4.8" ScaleY="4.8"
                                CenterX="0" CenterY="0"/>
                <TranslateTransform X="60" Y="60"/>
               
            </TransformGroup>
        </Canvas.RenderTransform>

        <Canvas.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="ActualTimeHour"
                            Storyboard.TargetProperty="Angle"
                            From="0.0" To="360.0"
                            Duration="01:00:00.00" RepeatBehavior="Forever"
                            />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Canvas.Triggers>
    </Canvas>

</Window>
